{
  "name": "novel-builder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node e2e/smoke.mjs",
    "test:e2e:built": "node e2e/built.mjs",
    "test:a11y": "node e2e/built.mjs a11y.mjs",
    "test:perf": "node e2e/built.mjs perf.mjs",
    "test:offline": "node e2e/offline.mjs",
    "test:links": "node e2e/built.mjs links.mjs",
    "qa:sample": "node scripts/qa-sample.mjs",
    "relay": "node server/relay.ts",
    "app:android": "npm run build && cap sync android && cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../release/NovelBuilder-$npm_package_version.apk",
    "app:desktop": "npm run build && node scripts/build-desktop.mjs",
    "app:web": "npm run build && rm -rf release/web && cp -R dist release/web"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "d3-force": "^3.0.0",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@electron/packager": "^20.3.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "fake-indexeddb": "^6.2.5",
    "playwright": "^1.64.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
