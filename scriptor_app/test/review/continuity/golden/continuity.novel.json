  "chapterContents": [
   {
    "id": "c1",
    "projectId": "cont",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Mira drew the Sunblade and raised it high. Her grey eyes shone."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "They rode for two days to reach Vell from the Keep."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Alex was nineteen years old. Alex’s hair was black."
        }
       ]
      },
      {
       "type": "heading",
       "attrs": {
        "level": 2
       },
       "content": [
        {
         "type": "text",
         "text": "Interlude"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Mira said nothing , and Jmaes waved. the the end"
        }
       ]
      }
     ]
    }
   },
   {
    "id": "c2",
    "projectId": "cont",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Mira smiled at Kai."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "They spoke of Mira, who had said nothing."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Kai drew the Sunblade in the dark of night."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "The ",
         "marks": [
          {
           "type": "entityLink",
           "attrs": {
            "entryId": "mira"
           }
          }
         ]
        },
        {
         "type": "text",
         "text": "heir",
         "marks": [
          {
           "type": "bold"
          },
          {
           "type": "entityLink",
           "attrs": {
            "entryId": "mira"
           }
          }
         ]
        },
        {
         "type": "text",
         "text": " laughed and walked away."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Alex’s hair was golden. Alex, 25, ran. Alex is 21 and tall."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Her blue eyes shone when Mira turned."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "James ran. James stopped. James looked back. Kai didn’t looked back."
        }
       ]
      }
     ]
    }
   },
   {
    "id": "c3",
    "projectId": "cont",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "In the dark cave, Kai called on the Void."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "It took half an hour to cross from Vell to the Keep."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Kai ran with both hands on the rope."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "She wore the Ring, then pocketed the Ring."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "“Wait, she said. The road is gone."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "The Void answered, far from any cave."
        }
       ]
      }
     ]
    }
   },
   {
    "id": "s1",
    "projectId": "cont",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Mira walked in, and Mira said: “Night is here.”"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "It was a journey of three weeks by sea to Vell; the Keep was a day away."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Kai was twenty-two years old."
        }
       ]
      }
     ]
    }
   },
   {
    "id": "c4",
    "projectId": "cont",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Some words with no title above them. i saw it. he left. she stayed."
        }
       ]
      }
     ]
    }
   },
