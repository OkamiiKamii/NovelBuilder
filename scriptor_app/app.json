{
  "expo": {
    "name": "Scriptor",
    "slug": "scriptor",
    "version": "0.1.0",
    "platforms": [
      "android"
    ],
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "scriptor",
    "android": {
      "package": "com.scriptor.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground-safe.png",
        "backgroundColor": "#0A0B0E"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "backgroundColor": "#0A0B0E",
    "plugins": [
      "expo-sqlite",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Outfit",
                "path": "./assets/fonts/Outfit.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  },
                  {
                    "weight": 600
                  },
                  {
                    "weight": 700
                  },
                  {
                    "weight": 800
                  },
                  {
                    "weight": 900
                  }
                ]
              },
              {
                "fontFamily": "Merriweather",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Merriweather.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Merriweather.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Merriweather.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Merriweather.ttf",
                    "weight": 900
                  },
                  {
                    "path": "./assets/fonts/Merriweather-Italic.ttf",
                    "weight": 400,
                    "style": "italic"
                  },
                  {
                    "path": "./assets/fonts/Merriweather-Italic.ttf",
                    "weight": 700,
                    "style": "italic"
                  }
                ]
              },
              {
                "fontFamily": "Merriweather-Italic",
                "path": "./assets/fonts/Merriweather-Italic.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "JetBrainsMono",
                "path": "./assets/fonts/JetBrainsMono.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 500
                  },
                  {
                    "weight": 600
                  },
                  {
                    "weight": 700
                  },
                  {
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Cinzel",
                "path": "./assets/fonts/Cinzel.ttf",
                "fontDefinitions": [
                  {
                    "weight": 400
                  },
                  {
                    "weight": 600
                  },
                  {
                    "weight": 700
                  },
                  {
                    "weight": 900
                  }
                ]
              }
            ]
          }
        }
      ],
      "expo-router",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "microphonePermission": false,
          "cameraPermission": false
        }
      ],
      "./plugins/withReleaseSigning",
      "./plugins/withShortcuts",
      "./plugins/withWritingWidget",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0B0E",
          "image": "./assets/android-icon-foreground-safe.png",
          "imageWidth": 220
        }
      ]
    ]
  }
}
