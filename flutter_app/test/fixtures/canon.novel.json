  "chapterContents": [
   {
    "id": "c1",
    "projectId": "canon",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Mira drew the Sunblade and raised it high."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Orrin was nineteen years old, and his hands were steady."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Her grey eyes shone with tears. Mira wept."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "They travelled for two days to reach Saltport from Greykeep."
        }
       ]
      },
      {
       "type": "heading",
       "content": [
        {
         "type": "text",
         "text": "Interlude"
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Orrin gripped the Sunblade with both hands."
        }
       ]
      }
     ]
    },
    "updatedAt": 0
   },
   {
    "id": "c2",
    "projectId": "canon",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Mira smiled at the guard."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "They spoke of Mira often, and of the Sunblade."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "The Heiress",
         "marks": [
          {
           "type": "entityLink",
           "attrs": {
            "entryId": "mira"
           }
          }
         ]
        },
        {
         "type": "text",
         "text": " said nothing."
        }
       ]
      }
     ]
    },
    "updatedAt": 0
   },
   {
    "id": "s2a",
    "projectId": "canon",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Deep underground, the caves were cold."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Kai cast the fire spell anyway, half an hour later."
        }
       ]
      }
     ]
    },
    "updatedAt": 0
   },
   {
    "id": "c3",
    "projectId": "canon",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "The Sunblade lay forgotten."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Orrin drew the Sunblade, the blade in his hand."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Pell, 23, laughed."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Alex’s hair was black as night."
        }
       ]
      }
     ]
    },
    "updatedAt": 0
   },
   {
    "id": "c4",
    "projectId": "canon",
    "doc": {
     "type": "doc",
     "content": [
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "Mira returned, said nothing, and walked on."
        }
       ]
      },
      {
       "type": "paragraph",
       "content": [
        {
         "type": "text",
         "text": "It took a week to reach Saltport from Greykeep."
        }
       ]
      }
     ]
    },
    "updatedAt": 0
   }
  ],
