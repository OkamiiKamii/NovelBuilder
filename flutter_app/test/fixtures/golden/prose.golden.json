      "00000000-0000-4000-8000-000000000019": {
        "blocks": [
          {
            "heading": false,
            "text": "The tide came in grey over Port Calder, and Ilse read it in the window glass before it reached the harbour wall."
          },
          {
            "heading": false,
            "text": "Wren asked her what she saw. She said rain, and a ledger, and a man who would want it back."
          },
          {
            "heading": false,
            "text": "Somewhere above the town, in the guild house, her old teacher was waiting for an answer she had not given."
          }
        ],
        "words": 62,
        "characters": 309,
        "paragraphs": 3,
        "mentions": [
          "00000000-0000-4000-8000-00000000000a",
          "00000000-0000-4000-8000-000000000002",
          "00000000-0000-4000-8000-000000000006"
        ]
      },
      "00000000-0000-4000-8000-00000000001a": {
        "blocks": [
          {
            "heading": false,
            "text": "Corin pressed the guild mark into the warm glass and handed it to her without a word."
          },
          {
            "heading": false,
            "text": "The burn on his wrist was older than she was. She had asked about it once, as a child, and he had looked at the hills and said nothing at all."
          },
          {
            "heading": false,
            "text": "Ilse took the mark. From that night she was one of the Glasswrights, whatever came after."
          }
        ],
        "words": 64,
        "characters": 316,
        "paragraphs": 3,
        "mentions": [
          "00000000-0000-4000-8000-000000000003",
          "00000000-0000-4000-8000-000000000002",
          "00000000-0000-4000-8000-000000000007"
        ]
      },
      "00000000-0000-4000-8000-00000000001c": {
        "blocks": [
          {
            "heading": false,
            "text": "The Archive smelled of dust and lamp oil. Tamsin had the door open before Ilse finished reading the lock."
          },
          {
            "heading": false,
            "text": "The Ledger of Tides was lighter than either of them had thought. They argued about who would carry it, and then ran."
          }
        ],
        "words": 41,
        "characters": 221,
        "paragraphs": 2,
        "mentions": [
          "00000000-0000-4000-8000-000000000004",
          "00000000-0000-4000-8000-000000000002",
          "00000000-0000-4000-8000-000000000008"
        ]
      },
      "00000000-0000-4000-8000-00000000001d": {
        "blocks": [
          {
            "heading": false,
            "text": "Across the square, Magistrate Hale counted the raised hands in Council Hall and smiled at the number."
          },
          {
            "heading": false,
            "text": "He did not yet know the Archive stood open."
          }
        ],
        "words": 26,
        "characters": 144,
        "paragraphs": 2,
        "mentions": [
          "00000000-0000-4000-8000-000000000005",
          "00000000-0000-4000-8000-00000000000c"
        ]
      },
      "00000000-0000-4000-8000-00000000001e": {
        "blocks": [
          {
            "heading": false,
            "text": "They left Port Calder by the salt road before dawn. Tamsin walked ahead; Ilse carried the ledger."
          },
          {
            "heading": false,
            "text": "By the third night they had stopped arguing. By the fourth they were friends, though neither said it."
          }
        ],
        "words": 35,
        "characters": 198,
        "paragraphs": 2,
        "mentions": [
          "00000000-0000-4000-8000-00000000000a",
          "00000000-0000-4000-8000-000000000004",
          "00000000-0000-4000-8000-000000000002"
        ]
      }
    },
